def create_aptitude_json_files():
    """
    Creates organized JSON files for GATE Aptitude questions
    Structure: questions/GATE_Aptitude/[Year]/[Branch]/aptitude.json
    """
    
    base_dir = "questions"
    aptitude_dir = os.path.join(base_dir, "GATE_Aptitude")
    
    # Create base directory
    os.makedirs(aptitude_dir, exist_ok=True)
    
    # Statistics tracking
    total_questions = 0
    files_created = []
    
    for year, branches in gate_aptitude_questions.items():
        for branch, questions in branches.items():
            # Create year/branch directory structure
            branch_dir = os.path.join(aptitude_dir, f"{year}_{branch}")
            os.makedirs(branch_dir, exist_ok=True)
            
            # Create filename
            file_path = os.path.join(branch_dir, "aptitude.json")
            
            # Save questions
            with open(file_path, 'w', encoding='utf-8') as f:
                json.dump(questions, f, indent=2, ensure_ascii=False)
            
            total_questions += len(questions)
            files_created.append(file_path)
            
            print(f"✅ Created: {file_path} ({len(questions)} questions)")
    
    # Create a master index file
    master_file = os.path.join(aptitude_dir, "_index.json")
    
    master_index = {
        "description": "GATE Aptitude Questions - All Years, All Branches",
        "total_years": len(gate_aptitude_questions),
        "total_branches": sum(len(branches) for branches in gate_aptitude_questions.values()),
        "total_questions": total_questions,
        "years_available": list(gate_aptitude_questions.keys()),
        "structure": {
            year: list(branches.keys()) 
            for year, branches in gate_aptitude_questions.items()
        },
        "tags_available": [
            "Grammar", "Vocabulary", "Synonyms", "Analogies",
            "Logical Reasoning", "Relations", "Syllogism", "Pattern Recognition",
            "Quantitative", "Arithmetic", "Average", "Profit-Loss", "Speed-Distance-Time",
            "Geometry", "Mensuration", "Areas", "Probability", "Combinatorics",
            "Set Theory", "Time-Work", "Pipes-Cisterns", "Age Problems", "Calendar"
        ]
    }
    
    with open(master_file, 'w', encoding='utf-8') as f:
        json.dump(master_index, f, indent=2, ensure_ascii=False)
    
    print(f"\n📊 Summary:")
    print(f"   Total Questions: {total_questions}")
    print(f"   Total Files: {len(files_created)}")
    print(f"   Master Index: {master_file}")
    
    print(f"\n📁 Directory Structure:")
    print(f"   {base_dir}/")
    print(f"   └── GATE_Aptitude/")
    for year in gate_aptitude_questions.keys():
        print(f"       ├── {year}_*/")
        print(f"       │   └── aptitude.json")
    print(f"       └── _index.json")
    
    print(f"\n🎯 How to use in your bot:")
    print(f"   1. Copy this file to your project directory")
    print(f"   2. Run: python gate_aptitude_generator.py")
    print(f"   3. Start your bot: python bot.py")
    print(f"   4. Use /tests or /topics to access the questions")
    
    print(f"\n💡 Question Format Features:")
    print(f"   ✓ Year-wise organization")
    print(f"   ✓ Branch-wise categorization (CS, EC, ME, etc.)")
    print(f"   ✓ Tag-based classification")
    print(f"   ✓ Difficulty levels")
    print(f"   ✓ Detailed explanations")
    print(f"   ✓ 🧮 Calculator emoji for numerical questions")
    
    return files_created

